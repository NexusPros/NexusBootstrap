       install it), not the runtime querying/CRUD the charter is actually guarding against. See
       PreflightChecker.CheckPostgresProvisionedAsync for the one call site this reference exists
       for. -->
  <ItemGroup>
    <ProjectReference Include="..\..\NexusProShared\NexusPostgresProvisioning\NexusPostgresProvisioning\NexusPostgresProvisioning.csproj" />
  </ItemGroup>

</Project>
